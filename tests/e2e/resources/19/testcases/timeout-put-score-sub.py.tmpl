#!/usr/bin/env python3
import time
import urllib.request
import json

ENDPOINT = '{{ .endpoint }}'
JOB_TOKEN = '{{ .jobToken }}'
SUB_ID = {{ .subId }}

print(f"Endpoint: {ENDPOINT}")
print(f"SubId: {SUB_ID}")

# Sleep longer than the timeout (timeout is 2s, we sleep 5s)
# The job should be killed before we can put the score
print("Sleeping for 5 seconds...")
time.sleep(5)

# This should never be reached due to timeout
print("Putting score 99...")
data = json.dumps({"score": 99}).encode('utf-8')
req = urllib.request.Request(
    f"{ENDPOINT}/score",
    data=data,
    method='PUT',
    headers={
        'Authorization': f'Bearer {JOB_TOKEN}',
        'Content-Type': 'application/json',
    }
)
with urllib.request.urlopen(req) as response:
    print(response.read().decode('utf-8'))

print("Score updated successfully")
