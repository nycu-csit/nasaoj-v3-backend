#!/usr/bin/bash
set -o errexit

ENDPOINT='{{ .endpoint }}'
JOB_TOKEN='{{ .jobToken }}'
JOB_INPUT='{{ .jobInput }}'
JOB_SCRIPT='{{ .jobScript }}'

echo "File JOB_INPUT: $JOB_INPUT"
cat "$JOB_INPUT"
echo

echo "File JOB_SCRIPT: $JOB_SCRIPT"
cat "$JOB_SCRIPT"
echo

put_args() {
  curl "$ENDPOINT/api/user" -X PUT \
    -H "Authorization: Bearer $JOB_TOKEN" \
    --fail --no-progress-meter --json @-
}

randomString="$(openssl rand -base64 24)"
echo "random string: $randomString"

put_args <<EOF
  {"pass": "$randomString"}
EOF

put_args <<EOF
  {"poop": "poop"}
EOF

# vim: syntax=bash
