            "get": {
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Problem Id",
                        "name": "problemId",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Last submission to the problem",
