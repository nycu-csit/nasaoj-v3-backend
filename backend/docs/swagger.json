        "/api/admin/reloadscores": {
            "post": {
                "responses": {
                    "200": {
                        "description": "Success",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "401": {
                        "description": "Unauthorized"
                    }
                }
            }
        },
        "/api/admin/results": {
            "get": {
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Submission Id",
                        "name": "subId",
