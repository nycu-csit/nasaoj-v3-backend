    "definitions": {
        "handlers.MeOutput": {
            "type": "object",
            "properties": {
                "isAdmin": {
                    "type": "boolean"
                },
                "jwtClaim": {
                    "$ref": "#/definitions/models.JWTClaim"
                },
                "resource": {
                    "$ref": "#/definitions/models.UserResource"
                }
            }
        },
        "handlers.ScoreOutput": {
            "type": "object",
            "properties": {
                "csId": {
                    "type": "string"
                },
                "score": {
                    "type": "integer"
                },
                "stages": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "integer"
                    }
                }
            }
        },
        "handlers.adminSubmitInput": {
            "type": "object",
            "properties": {
                "asCsId": {
                    "type": "string"
                },
                "problemId": {
                    "description": "Submit problem ID",
                    "type": "integer"
                }
            }
        },
        "handlers.problemOutput": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string"
                },
                "problemId": {
                    "type": "integer"
                },
                "stages": {
                    "type": "object",
