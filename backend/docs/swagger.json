{
    "swagger": "2.0",
    "info": {
        "title": "NASAOJ v3",
        "termsOfService": "http://swagger.io/terms/",
        "contact": {},
        "license": {
            "name": "WTFPL"
        },
        "version": "2.0"
    },
    "basePath": "/",
    "paths": {
        "/api/output": {
            "get": {
                "parameters": [
                    {
                        "type": "number",
                        "description": "Submission id",
                        "name": "subId",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Stage name",
                        "name": "stage",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Testcase name",
                        "name": "testcase",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Testcase result output",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/api/problems": {
            "get": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "produces": [
                    "application/json"
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/models.Problem"
                            }
                        }
                    }
                }
            }
        },
        "/api/results": {
            "get": {
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Problem ID",
                        "name": "problemId",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Last submission to the problem",
                        "schema": {
                            "$ref": "#/definitions/models.Submission"
                        }
                    }
                }
            }
        },
        "/api/submit": {
            "put": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "consumes": [
                    "application/json"
                ],
                "parameters": [
                    {
                        "description": "query params",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handlers.SubmitInput"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/models.Submission"
                        }
                    }
                }
            }
        },
        "/auth/callback": {
            "get": {
                "responses": {
                    "302": {
                        "description": "302 Found",
                        "schema": {
                            "type": ""
                        }
                    }
                }
            }
        },
        "/auth/login": {
            "get": {
                "description": "OAuth login endpoint",
                "responses": {
                    "302": {
                        "description": "302 Found",
                        "schema": {
                            "type": ""
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "handlers.SubmitInput": {
            "type": "object",
            "properties": {
                "problem_id": {
                    "description": "Submit problem ID",
                    "type": "integer"
                }
            }
        },
        "models.Job": {
            "type": "object",
            "properties": {
                "execat": {
                    "type": "integer"
                },
                "output": {
                    "type": "string"
                },
                "retcode": {
                    "type": "integer"
                },
                "stagename": {
                    "type": "string"
                },
                "subid": {
                    "type": "integer"
                },
                "testcontent": {
                    "type": "string"
                },
                "testname": {
                    "type": "string"
                }
            }
        },
        "models.Problem": {
            "type": "object",
            "properties": {
                "args": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                },
                "name": {
                    "type": "string"
                },
                "problemId": {
                    "type": "integer"
                },
                "stages": {
                    "type": "object",
                    "additionalProperties": {
                        "$ref": "#/definitions/models.Stage"
                    }
                }
            }
        },
        "models.Stage": {
            "type": "object",
            "properties": {
                "args": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                },
                "before": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "score": {
                    "type": "integer"
                },
                "testcases": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/models.Testcase"
                    }
                }
            }
        },
        "models.Submission": {
            "type": "object",
            "properties": {
                "args": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                },
                "csid": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "jobs": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/models.Job"
                    }
                },
                "problemid": {
                    "type": "integer"
                },
                "problemname": {
                    "type": "string"
                },
                "score": {
                    "type": "integer"
                },
                "submitat": {
                    "type": "integer"
                }
            }
        },
        "models.Testcase": {
            "type": "object",
            "properties": {
                "args": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                },
                "file": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "weight": {
                    "type": "integer"
                }
            }
        }
    },
    "securityDefinitions": {
        "ApiKeyAuth": {
            "description": "jwt=value, get it at /auth/login",
            "type": "apiKey",
            "name": "Cookie",
            "in": "header"
        }
    }
}