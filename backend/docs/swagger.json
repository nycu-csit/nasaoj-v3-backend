                            "type": "string"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/api/admin/stdout": {
            "get": {
                "parameters": [
                    {
                        "type": "number",
                        "description": "Submission id",
                        "name": "subId",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Stage name",
                        "name": "stage",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Testcase name",
                        "name": "testcase",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Testcase result stdout",
