{
    "swagger": "2.0",
    "info": {
        "title": "NASAOJ v3",
        "termsOfService": "http://swagger.io/terms/",
        "contact": {},
        "license": {
            "name": "WTFPL"
        },
        "version": "2.0"
    },
    "basePath": "/",
    "paths": {
        "/api/output": {
            "get": {
                "parameters": [
                    {
                        "type": "number",
                        "description": "Submission id",
                        "name": "subId",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Stage name",
                        "name": "stage",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Testcase name",
                        "name": "testcase",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Testcase result output",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/api/problems": {
            "get": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "produces": [
                    "application/json"
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/handlers.problemOutput"
                            }
                        }
                    },
                    "500": {
                        "description": "Problem loading error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/api/results": {
            "get": {
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Problem ID",
                        "name": "problemId",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Last submission to the problem",
                        "schema": {
                            "$ref": "#/definitions/handlers.resultOutput"
                        }
                    },
                    "400": {
                        "description": "Problem ID invalid",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "401": {
                        "description": "User resource missing",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "No submission",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/api/submit": {
            "put": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "consumes": [
                    "application/json"
                ],
                "parameters": [
                    {
                        "description": "query params",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handlers.submitInput"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handlers.submitOutput"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/auth/callback": {
            "get": {
                "responses": {
                    "302": {
                        "description": "302 Found",
                        "schema": {
                            "type": ""
                        }
                    }
                }
            }
        },
        "/auth/login": {
            "get": {
                "description": "OAuth login endpoint",
                "responses": {
                    "302": {
                        "description": "302 Found",
                        "schema": {
                            "type": ""
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "handlers.problemOutput": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string"
                },
                "problemId": {
                    "type": "integer"
                },
                "stages": {
                    "type": "object",
                    "additionalProperties": {
                        "$ref": "#/definitions/handlers.problemOutputStage"
                    }
                }
            }
        },
        "handlers.problemOutputStage": {
            "type": "object",
            "properties": {
                "before": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "score": {
                    "type": "integer"
                },
                "testcases": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/handlers.problemOutputStageTestcase"
                    }
                }
            }
        },
        "handlers.problemOutputStageTestcase": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string"
                }
            }
        },
        "handlers.resultOutput": {
            "type": "object",
            "properties": {
                "csId": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "jobs": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/handlers.resultOutputJob"
                    }
                },
                "pending": {
                    "type": "integer"
                },
                "problemId": {
                    "type": "integer"
                },
                "problemName": {
                    "type": "string"
                },
                "score": {
                    "type": "integer"
                },
                "submitAt": {
                    "type": "integer"
                }
            }
        },
        "handlers.resultOutputJob": {
            "type": "object",
            "properties": {
                "execAt": {
                    "type": "integer"
                },
                "retCode": {
                    "type": "integer"
                },
                "stageName": {
                    "type": "string"
                },
                "testName": {
                    "type": "string"
                }
            }
        },
        "handlers.submitInput": {
            "type": "object",
            "properties": {
                "problemId": {
                    "description": "Submit problem ID",
                    "type": "integer"
                }
            }
        },
        "handlers.submitOutput": {
            "type": "object",
            "properties": {
                "csId": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "problemId": {
                    "type": "integer"
                },
                "problemName": {
                    "type": "string"
                },
                "submitAt": {
                    "type": "integer"
                }
            }
        }
    },
    "securityDefinitions": {
        "ApiKeyAuth": {
            "description": "jwt=value, get it at /auth/login",
            "type": "apiKey",
            "name": "Cookie",
            "in": "header"
        }
    }
}