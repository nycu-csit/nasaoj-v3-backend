        "/auth/callback": {
            "get": {
                "responses": {
                    "302": {
                        "description": "302 Found",
                        "schema": {
                            "type": ""
                        }
                    }
                }
            }
        },
        "/auth/login": {
            "get": {
                "description": "OAuth login endpoint",
                "responses": {
                    "302": {
                        "description": "302 Found",
                        "schema": {
                            "type": ""
                        }
                    }
                }
            }
        }
