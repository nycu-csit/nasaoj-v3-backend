                        }
                    },
                    "400": {
                        "description": "Problem ID invalid",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "401": {
                        "description": "User resource missing",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "No submission",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
