                        "type": "string"
                    }
                },
                "score": {
                    "type": "integer"
                },
                "testcases": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/handlers.problemOutputStageTestcase"
                    }
                }
            }
        },
        "handlers.problemOutputStageTestcase": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string"
                }
            }
        },
        "handlers.resultOutput": {
            "type": "object",
            "properties": {
                "csId": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "jobs": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/handlers.resultOutputJob"
                    }
                },
                "problemId": {
                    "type": "integer"
                },
                "problemName": {
                    "type": "string"
                },
                "score": {
                    "type": "integer"
                },
                "submitAt": {
                    "type": "integer"
                }
            }
        },
        "handlers.resultOutputJob": {
            "type": "object",
            "properties": {
                "execAt": {
                    "type": "integer"
                },
                "retCode": {
                    "type": "integer"
                },
                "stageName": {
                    "type": "string"
                },
                "status": {
                    "$ref": "#/definitions/models.JobStatus"
                },
                "testName": {
                    "type": "string"
                }
            }
        },
        "handlers.submissionsOutput": {
            "type": "object",
            "properties": {
                "pageSize": {
                    "type": "integer"
                },
                "submissions": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/handlers.submissionsOutputSubmission"
                    }
                },
                "totalRowCnt": {
                    "type": "integer"
                }
            }
        },
        "handlers.submissionsOutputSubmission": {
            "type": "object",
            "properties": {
                "csId": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "problemId": {
                    "type": "integer"
                },
                "problemName": {
                    "type": "string"
                },
                "score": {
                    "type": "integer"
                },
                "submitAt": {
                    "type": "integer"
                }
            }
        },
        "handlers.submitInput": {
            "type": "object",
            "properties": {
                "problemId": {
                    "description": "Submit problem ID",
                    "type": "integer"
                }
            }
        },
        "handlers.submitOutput": {
            "type": "object",
            "properties": {
                "csId": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "problemId": {
                    "type": "integer"
                },
                "problemName": {
                    "type": "string"
                },
                "submitAt": {
                    "type": "integer"
                }
            }
        },
        "jwt.NumericDate": {
            "type": "object",
            "properties": {
                "time.Time": {
                    "type": "string"
                }
            }
        },
        "models.JWTClaim": {
            "type": "object",
            "properties": {
                "aud": {
                    "description": "the `aud` (Audience) claim. See https://datatracker.ietf.org/doc/html/rfc7519#section-4.1.3",
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "csId": {
                    "type": "string"
                },
                "exp": {
                    "type": "integer"
                },
                "groups": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "iat": {
                    "type": "integer"
                },
                "iss": {
                    "description": "the `iss` (Issuer) claim. See https://datatracker.ietf.org/doc/html/rfc7519#section-4.1.1",
                    "type": "string"
                },
                "jti": {
                    "description": "the `jti` (JWT ID) claim. See https://datatracker.ietf.org/doc/html/rfc7519#section-4.1.7",
                    "type": "string"
                },
                "nbf": {
                    "description": "the `nbf` (Not Before) claim. See https://datatracker.ietf.org/doc/html/rfc7519#section-4.1.5",
                    "allOf": [
                        {
                            "$ref": "#/definitions/jwt.NumericDate"
                        }
                    ]
                },
                "sub": {
                    "description": "the `sub` (Subject) claim. See https://datatracker.ietf.org/doc/html/rfc7519#section-4.1.2",
                    "type": "string"
                }
            }
        },
        "models.JobStatus": {
            "type": "integer",
            "enum": [
                260,
                261,
                262,
                460,
                461,
                560
            ],
            "x-enum-varnames": [
                "StatusPending",
                "StatusRunning",
                "StatusSuccess",
                "StatusFailed",
                "StatusSkip",
                "StatusMissing"
            ]
        },
        "models.UserResource": {
            "type": "object",
            "properties": {
                "csId": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "roomId": {
                    "type": "string"
                }
            }
        }
    },
    "securityDefinitions": {
        "ApiKeyAuth": {
            "description": "jwt=value, get it at /auth/login",
            "type": "apiKey",
            "name": "Cookie",
            "in": "header"
        }
    }
