            "get": {
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Problem ID",
                        "name": "problemId",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Scores",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/handlers.ScoreOutput"
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid problem id",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/api/stdout": {
            "get": {
                "parameters": [
                    {
                        "type": "number",
                        "description": "Submission id",
                        "name": "subId",
