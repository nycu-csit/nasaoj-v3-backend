                            "type": "string"
                        }
                    },
                    "400": {
                        "description": "Bad Request"
                    },
                    "404": {
                        "description": "Not Found"
                    }
                }
            }
        },
        "/api/admin/submissions": {
            "get": {
                "parameters": [
                    {
                        "type": "integer",
                        "default": 0,
                        "description": "Page number, one page is 20 submissions",
                        "name": "pageNum",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Filter by CsId",
                        "name": "csId",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Filter by Problem Id",
                        "name": "problemId",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "All submission within the problem",
                        "schema": {
                            "$ref": "#/definitions/handlers.submissionsOutput"
                        }
                    },
                    "400": {
                        "description": "Problem Id invalid",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "401": {
                        "description": "not admin or didn't login",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/api/admin/submit": {
            "put": {
                "consumes": [
                    "application/json"
                ],
                "parameters": [
                    {
                        "description": "query params",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handlers.adminSubmitInput"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handlers.submitOutput"
                        }
                    },
                    "400": {
                        "description": "Bad Request"
                    },
                    "401": {
                        "description": "Unauthorized"
                    },
                    "429": {
                        "description": "Too Many Requests"
                    }
                }
            }
        },
        "/api/admin/users": {
            "get": {
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/models.UserResource"
                            }
                        }
                    },
                    "401": {
                        "description": "not admin or not login",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/api/me": {
            "get": {
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
