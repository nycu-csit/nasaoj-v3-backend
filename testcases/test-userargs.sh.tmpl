#!/usr/bin/bash
set -o errexit

ENDPOINT='{{ .endpoint }}'
JOB_TOKEN='{{ .jobToken }}'

put_args() {
  curl "$ENDPOINT/api/user" -X PUT \
    -H "Authorization: Bearer $JOB_TOKEN" \
    --fail --no-progress-meter --json @-
}

randomString="$(openssl rand -base64 24)"
echo "random string: $randomString"

put_args <<EOF
  {"pass": "$randomString"}
EOF

put_args <<EOF
  {"poop": "poop"}
EOF

# vim: syntax=bash
